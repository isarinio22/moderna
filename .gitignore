# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated data (regenerate with `make all`)
data/cache/
data/interim/
data/processed/
data/source_pdfs/

# Scratch output (the evidence report, rebuilt by `make evidence`)
out/

# figures/ and linkedin/ ARE tracked. They are deterministic build artifacts,
# and the README and GitHub Pages both serve them directly, so they have to be
# in the repository. `make figures-check` asserts a rebuild is byte-identical.

# Video is the exception: ffmpeg embeds encoder metadata that cannot be fully
# suppressed, so it is not byte-reproducible and would keep the tree dirty.
linkedin/*.mp4
linkedin/*.gif

# OS
.DS_Store

# Per-run build state (stage config fingerprints)
build/
